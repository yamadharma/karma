inherit cargo systemd

DESCRIPTION="Standalone Wayland clipboard and file-transfer bridge for SPICE/QEMU guests"
HOMEPAGE="https://github.com/thelicato/paprika-vdagent"
SRC_URI="
	https://github.com/thelicato/paprika-vdagent/archive/refs/tags/v${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"

LICENSE="GPL-3"
SLOT="0"
KEYWORDS="~amd64 ~arm64"

src_install() {
	cargo_src_install

	# User systemd unit shipped by upstream; adjust the path
	# if upstream moved packaging around between releases
	systemd_douserunit packaging/systemd/user/paprika-vdagent.service

	einstalldocs
}

pkg_postinst() {
	ewarn "The stock spice-vdagent competes for the same virtio channel."
	ewarn "Disable it first:"
	ewarn "  sudo systemctl disable --now spice-vdagentd.service spice-vdagentd.socket"
	ewarn "  sudo pkill -x spice-vdagent || true"
	einfo
	einfo "Then enable the user unit (e.g. from sway config):"
	einfo "  systemctl --user import-environment WAYLAND_DISPLAY XDG_RUNTIME_DIR"
	einfo "  systemctl --user enable --now paprika-vdagent.service"
}
